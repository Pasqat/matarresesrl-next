NEXT_PUBLIC_DOMAIN=https://example.com

# Google Tag Manager & Facebook Pixel
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=XXXXXXXXXXXXXXX

# Google Maps API
NEXT_PUBLIC_MAPS_API=AIzaSy...
# Map ID dello stile della mappa (opzionale, c'è un default in components/Maps/Map.jsx)
NEXT_PUBLIC_MAPS_ID=

# Mailchimp (iscrizione alla newsletter)
MAILCHIMP_API_KEY=...-us14
MAILCHIMP_LIST_ID=af8c0de45a
# ID del permesso marketing "email" dell'audience (opzionale, default in pages/api/subscribe.js)
MAILCHIMP_PERMESSO_EMAIL=

# Resend (obbligatorio per invio email)
RESEND_API_KEY=
CONTACT_FROM=no-replay@example.com
CONTACT_TO=
# Richieste di assistenza (guasti): se vuoto, service@matarrese.it
CONTACT_TO_ASSISTENZA=

# Rate limiting (opzionale)
RATE_LIMIT_WINDOW=60  # Finestra in secondi
RATE_LIMIT_MAX=10     # Massime richieste per IP nella finestra

# Odoo integration (opzionale)
# Crea un lead per le richieste commerciali. Mai bloccante: se Odoo fallisce o supera 5 s,
# la richiesta resta comunque nella mail.
ODOO_ENABLED=true
ODOO_URL=https://your-odoo-domain.com
ODOO_DB=your-odoo-domain
ODOO_USER=your-odoo-user@email.com
# Solo API key, la password non è più usata
ODOO_API_KEY=your-odoo-api-key

# ID Odoo (opzionale — usati per tag e sorgente del lead)
ODOO_TAG_ID=14        # ID del tag CRM da applicare al lead (es. 'sitoweb-form')
ODOO_SOURCE_ID=11     # ID della sorgente CRM (es. 'Sito web')

# Pannello Matarrese (obbligatorio): news, realizzazioni, eventi, chiusure, avviso, recensioni e marchi.
# Online https://cms.matarrese.it; in locale il pannello di sviluppo, es. http://localhost:8001
NEXT_PUBLIC_PANNELLO_URL=
